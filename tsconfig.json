{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "types": ["bun", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "job", "review", "rev", "review-factory.ts", "machine.ts", "plugin", "manifest.ts", "doors.ts", "store.ts", "register.ts", "serve.ts", "build.ts", "vite.config.ts", "factory.ts", "git.ts", "place.ts", "skills.ts", "transcript.ts", "watch.ts", "host-ask.ts"]
}
